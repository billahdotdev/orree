# Copy this file to .env (or .env.local) and fill in real values.
# .env* files are gitignored — never commit real secrets.
#
# On Cloudflare Pages, set these under:
#   Settings → Environment variables → Production (and Preview)
# The VITE_* ones are build-time and safe to expose in the client bundle.

# ── Backend (Google Apps Script) ────────────────────────────────────
# Apps Script Web App URL — see google-apps-script/Code.gs for setup.
# Without it, WhatsApp/Messenger ordering still works — orders just won't
# be logged to a Google Sheet.
VITE_SHEETS_WEBHOOK_URL=

# ── Spam protection (Cloudflare Turnstile) ──────────────────────────
# Turnstile SITE key (public — safe to expose). The matching SECRET key
# goes in google-apps-script/Code.gs, never here. Empty = Turnstile off,
# other spam protections still active.
VITE_TURNSTILE_SITE_KEY=

# ── Analytics & Pixel (build-time, public) ──────────────────────────
# Injected into index.html at build. Leave empty to disable that tracker
# entirely (no script loads, no data sent).
VITE_GA4_ID=            # e.g. G-XXXXXXXXXX  (GA4 Measurement ID)
VITE_META_PIXEL_ID=     # e.g. 000000000000000  (Meta Pixel / Dataset ID)

# ── Meta Conversions API (server-side, SECRET) ──────────────────────
# These power functions/api/capi.js. Set them as *Encrypted* env vars in
# Cloudflare (NOT prefixed with VITE_ — they must never reach the browser).
# Leave unset until you're ready; /api/capi no-ops without them.
#   META_PIXEL_ID       same value as VITE_META_PIXEL_ID
#   META_CAPI_TOKEN     Conversions API access token from Events Manager
#   META_TEST_EVENT_CODE  optional, e.g. TEST12345 — routes events to the
#                         Test Events tab in Events Manager so you can verify
#                         the pipeline before spending. REMOVE before scaling.

# ── Meta domain verification (build-time, public) ───────────────────
# Events Manager → Business Settings → Brand Safety → Domains. Without a
# verified domain you cannot configure the 8 priority events for Aggregated
# Event Measurement, and iOS conversions past the first opted-out user are
# silently discarded.
VITE_FB_DOMAIN_VERIFICATION=

# ── Google Ads (build-time, public) ─────────────────────────────────
# GA4's `purchase` event does NOT feed Google Ads bidding on its own. Ads
# needs its own conversion tag: an AW- conversion id plus the label of the
# purchase conversion action. Without both, Smart Bidding and Performance Max
# optimise toward clicks instead of orders.
#
# Google Ads → Goals → Conversions → your purchase action → Tag setup.
# The snippet shows `send_to: 'AW-1234567890/AbC-D_efGh12345'`:
#   VITE_GOOGLE_ADS_ID            = AW-1234567890
#   VITE_GOOGLE_ADS_PURCHASE_LABEL = AbC-D_efGh12345
# Leave empty to disable Google Ads tracking entirely.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_PURCHASE_LABEL=
